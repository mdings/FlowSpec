{
	"name": "obsidian-flowspec-graph",
	"version": "0.1.0",
	"private": true,
	"description": "Obsidian plugin for read-only FlowSpec relationship graphs.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
