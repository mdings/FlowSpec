{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(Flow|FLOW|Screen|SCREEN|Action|ACTION|Id|ID|Receives|Rules|Uses|Steps|Shows|Outcome|When|Once|If|At the same time|Go to)\\b.*$",
    "decreaseIndentPattern": "^\\s*(Otherwise|Flow|FLOW|Screen|SCREEN)\\b.*"
  },
  "folding": {
    "offSide": true
  }
}
