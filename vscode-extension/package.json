{
  "name": "flowspec",
  "displayName": "FlowSpec",
  "description": "Syntax highlighting for FlowSpec — a human-readable format for describing business logic.",
  "version": "0.1.0",
  "publisher": "flowspec",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "flowspec",
    "syntax highlighting",
    "business logic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flowspec/flowspec"
  },
  "contributes": {
    "languages": [
      {
        "id": "flowspec",
        "aliases": [
          "FlowSpec",
          "flowspec"
        ],
        "extensions": [
          ".flowspec"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flowspec",
        "scopeName": "source.flowspec",
        "path": "./syntaxes/flowspec.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node scripts/smoke-test.js",
    "package": "vsce package --no-dependencies",
    "vsix": "npm run package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.3.2"
  }
}
