{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FlowSpec",
  "scopeName": "source.flowspec",
  "_comment": "GENERATED by scripts/generate-language-surfaces.js from lib/language.js.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#top-level-directives"
    },
    {
      "include": "#id-directive"
    },
    {
      "include": "#entry-directive"
    },
    {
      "include": "#if-fails"
    },
    {
      "include": "#at-the-same-time"
    },
    {
      "include": "#go-to-id"
    },
    {
      "include": "#go-to"
    },
    {
      "include": "#section-directives"
    },
    {
      "include": "#flow-control"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#durations"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.flowspec",
      "match": "#.*$"
    },
    "top-level-directives": {
      "name": "meta.directive.structural.flowspec",
      "begin": "^(\\s*)(Flow|FLOW|Screen|SCREEN|Action|ACTION|Section|SECTION|Layout|LAYOUT)\\b\\s*:?",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.directive.flowspec"
        }
      },
      "end": "$",
      "contentName": "entity.name.flowspec",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#durations"
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "id-directive": {
      "name": "meta.directive.id.flowspec",
      "begin": "^(\\s*)(Id|ID)\\b\\s*:?",
      "beginCaptures": {
        "2": {
          "name": "keyword.other.metadata.flowspec"
        }
      },
      "end": "$",
      "contentName": "entity.name.identifier.flowspec",
      "patterns": [
        {
          "name": "entity.name.identifier.flowspec",
          "match": "[a-z0-9][a-z0-9._-]*"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "entry-directive": {
      "name": "meta.directive.entry.flowspec",
      "begin": "^(\\s*)(Entry)\\b\\s*:?",
      "beginCaptures": {
        "2": {
          "name": "keyword.other.metadata.flowspec"
        }
      },
      "end": "$",
      "contentName": "entity.name.flowspec",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#durations"
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "section-directives": {
      "name": "meta.directive.section.flowspec",
      "match": "^(\\s*)(Receives|Rules|Uses|Steps|Shows|Outcome)\\b\\s*:?",
      "captures": {
        "2": {
          "name": "keyword.control.section.flowspec"
        }
      }
    },
    "if-fails": {
      "name": "meta.flow-control.if-fails.flowspec",
      "match": "^(\\s*)(If\\b.+?\\bfails)\\b\\s*:?",
      "captures": {
        "2": {
          "name": "keyword.control.flow.flowspec"
        }
      }
    },
    "at-the-same-time": {
      "name": "meta.flow-control.at-the-same-time.flowspec",
      "match": "^(\\s*)(At the same time)\\b\\s*:?",
      "captures": {
        "2": {
          "name": "keyword.control.flow.flowspec"
        }
      }
    },
    "go-to-id": {
      "name": "meta.flow-control.go-to.flowspec",
      "begin": "^(\\s*)(Go to)\\b\\s*:?[ \\t]*([a-z0-9][a-z0-9._-]*)[ \\t]*(#.*)?$",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.flow.flowspec"
        },
        "3": {
          "name": "entity.name.identifier.flowspec"
        },
        "4": {
          "name": "comment.line.number-sign.flowspec"
        }
      },
      "end": "(?=^(?!\\s*$)(?!\\1[ \\t]+)|\\z)",
      "patterns": [
        {
          "include": "#go-to-arguments"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "go-to": {
      "name": "meta.flow-control.go-to.flowspec",
      "begin": "^(\\s*)(Go to)\\b\\s*:?[ \\t]*(.*?)[ \\t]*(#.*)?$",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.flow.flowspec"
        },
        "3": {
          "name": "entity.name.flowspec"
        },
        "4": {
          "name": "comment.line.number-sign.flowspec"
        }
      },
      "end": "(?=^(?!\\s*$)(?!\\1[ \\t]+)|\\z)",
      "patterns": [
        {
          "include": "#go-to-arguments"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "go-to-arguments": {
      "name": "meta.flow-control.go-to-argument.flowspec",
      "match": "^(\\s*)(With|Without)\\b\\s*:?",
      "captures": {
        "2": {
          "name": "keyword.control.argument.flowspec"
        }
      }
    },
    "flow-control": {
      "name": "meta.flow-control.flowspec",
      "match": "^(\\s*)(When|Once|If|Otherwise)\\b\\s*:?",
      "captures": {
        "2": {
          "name": "keyword.control.flow.flowspec"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.flowspec",
          "begin": "\"",
          "end": "\"|(?=$)",
          "patterns": [
            {
              "name": "constant.character.escape.flowspec",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.flowspec",
          "begin": "(?<![\\w])'",
          "end": "'|(?=$)",
          "patterns": [
            {
              "name": "constant.character.escape.flowspec",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "durations": {
      "name": "constant.numeric.duration.flowspec",
      "match": "\\b(\\d+(?:\\.\\d+)?)\\s+(seconds?|minutes?|hours?|days?)\\b"
    },
    "numbers": {
      "name": "constant.numeric.flowspec",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    }
  }
}
